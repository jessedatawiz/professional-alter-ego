PUSHOVER_TOKEN=your_pushover_token_here
PUSHOVER_USER=your_pushover_user_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=
# Newer OpenAI models (gpt-5/o-series) require "max_completion_tokens"; older ones use "max_tokens"
OPENAI_MAX_TOKENS_PARAM=max_completion_tokens
PROFILE_NAME=John Doe
LINKEDIN_PATH=me/linkedin.pdf
SUMMARY_PATH=me/summary.txt

# Token policy settings
MAX_MESSAGE_LENGTH=1000
MAX_SESSION_MESSAGES=20
TOKEN_POLICY_ENABLED=true

# Cost control settings
MAX_TOKENS=30000
MAX_TOOL_ITERATIONS=10

# RAG settings
DOCS_PATH=me
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_PATH=storage/qdrant
QDRANT_COLLECTION=profile
RAG_TOP_K=4
RAG_REBUILD=false

# Observability settings
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=professional-alter-ego
PHOENIX_PROJECT_DESCRIPTION=Chatbot emulating my professional profile (RAG over me/ docs).
PHOENIX_WORKING_DIR=storage/phoenix
